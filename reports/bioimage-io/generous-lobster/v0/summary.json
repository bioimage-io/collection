                        "channel_names": [
                            "raw"
                        ]
                    },
                    {
                        "type": "space",
                        "id": "z",
                        "size": {
                            "min": 16,
                            "step": 8
                        }
                    },
                    {
                        "type": "space",
                        "id": "y",
                        "size": {
                            "min": 64,
                            "step": 16
                        }
                    },
                    {
                        "type": "space",
                        "id": "x",
                        "size": {
                            "min": 64,
                            "step": 16
                        }
                    }
                ],
                "test_tensor": {
                    "source": "test_input.npy",
                    "sha256": "e1dbd731826a2268048c7b5a9757f6f4e64d16a37c87b388d8065456c43b5585"
