                                2
                            ],
                            [
                                2,
                                2,
                                2
                            ]
                        ],
                        "initial_features": 32,
                        "gain": 2,
                        "norm": "InstanceNorm"
                    }
                }
            },
            "torchscript": {
                "source": "weights_torchscript.pt",
                "sha256": "651b855a2ccad16581bb06d3f078d7d3ba8a9505d2ab6536f2d94f38976e9b97",
                "parent": "pytorch_state_dict",
                "pytorch_version": "2.7.1"
            }
        },
        "id": "generous-lobster",
        "id_emoji": "🦞"
