{
    "rdf_content": {
        "format_version": "0.5.12",
        "type": "model",
        "name": "SynapseNet Vesicles - Cryo-Electron Tomography",
        "description": "3D U-Net from SynapseNet that segments synaptic vesicles in cryo-electron tomograms at a voxel size of 1.35 nm in y/x and 0.88 nm in z.",
        "license": "CC-BY-4.0",
        "authors": [
            {
                "name": "Sarah Muth",
                "github_user": "SarahMuth"
            }
        ],
        "maintainers": [
            {
                "name": "Luca Freckmann",
                "github_user": "lufre1"
            }
        ],
        "cite": [
            {
                "text": "Muth et al. SynapseNet: Deep learning for automatic synapse reconstruction. Molecular Biology of the Cell, 2025.",
                "doi": "10.1091/mbc.E24-11-0519"
            }
        ],
        "tags": [
            "synapsenet",
            "electron-microscopy",
            "electron-tomography",
            "synapse",
            "segmentation",
            "unet",
            "pytorch",
            "vesicles",
            "3d",
            "cryo-electron-tomography",
            "domain-adaptation"
        ],
        "git_repo": "https://github.com/computational-cell-analytics/synapse-net",
        "documentation": {
            "source": "README.md",
            "sha256": "c502ec494aa353e3b0f467ab03f988eac3bd895245654ef322c93d0f47250cb7"
        },
