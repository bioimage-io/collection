            "light-sheet fluorescence microscopy",
            "instance segmentation",
            "3d",
            "pytorch",
            "biapy",
            "instance-segmentation",
            "resunet"
        ],
        "training_data": {
            "id": "splendid-falafel"
        },
        "type": "model",
        "uploader": {
            "email": "danialtza@gmail.com"
        },
        "version": "0.1.0",
        "weights": {
            "pytorch_state_dict": {
                "architecture": {
                    "callable": "ResUNet",
                    "kwargs": {
                        "activation": "elu",
                        "contrast": false,
                        "contrast_proj_dim": 256,
                        "drop_values": [
                            0,
                            0,
                            0,
                            0
                        ],
                        "explicit_activations": true,
                        "feature_maps": [
                            48,
                            64,
                            80,
                            96
                        ],
                        "head_activations": [
                            "ce_sigmoid",
                            "ce_sigmoid",
                            "linear"
                        ],
                        "image_shape": [
                            40,
                            128,
                            128,
                            1
                        ],
                        "isotropy": [
                            true,
                            true,
                            true,
                            true
                        ],
                        "k_size": 3,
                        "larger_io": false,
                        "normalization": "in",
                        "output_channel_info": [
                            "F",
                            "C",
                            "Dc"
                        ],
                        "output_channels": [
                            1,
                            1,
                            1
                        ],
                        "return_one_tensor": true,
                        "separated_decoders": false,
                        "upsample_layer": "convtranspose",
                        "yx_down": [
                            2,
                            2,
                            2
                        ],
                        "z_down": [
                            1,
                            1,
                            1
                        ]
                    },
                    "sha256": "c0d86c529b527ae960c5c00d1199fc782c902d36fe237cb27a0d2f9bd0389cce",
                    "source": "model.py"
