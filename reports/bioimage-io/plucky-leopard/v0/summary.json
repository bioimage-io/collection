            }
        ],
        "covers": [
            "cover1.png",
            "cover2.png"
        ],
        "description": "Oocyte segmentation in 3D light-sheet fluorescence microscopy images. Instance segmentation representation: F + C + Dc",
        "documentation": "documentation.md",
        "format_version": "0.5.7",
        "git_repo": "https://github.com/BiaPyX/BiaPy",
        "id": "plucky-leopard",
        "id_emoji": "🐆",
        "inputs": [
            {
                "axes": [
                    {
                        "size": 1,
                        "type": "batch"
                    },
                    {
                        "channel_names": [
                            "channel0"
                        ],
                        "type": "channel"
                    },
                    {
                        "id": "z",
                        "size": 40,
                        "type": "space"
                    },
                    {
                        "id": "y",
                        "size": 128,
                        "type": "space"
                    },
                    {
                        "id": "x",
                        "size": 128,
                        "type": "space"
                    }
                ],
                "data": {
                    "type": "float32"
                },
                "id": "input0",
                "preprocessing": [
                    {
                        "id": "ensure_dtype",
                        "kwargs": {
                            "dtype": "float32"
                        }
                    },
                    {
                        "id": "clip",
                        "kwargs": {
                            "axes": [
                                "z",
                                "y",
                                "x"
                            ],
                            "max_percentile": 99.8,
                            "min_percentile": 0.1
                        }
                    },
                    {
                        "id": "zero_mean_unit_variance",
                        "kwargs": {
                            "axes": [
                                "z",
                                "y",
                                "x"
                            ]
                        }
                    },
                    {
                        "id": "ensure_dtype",
                        "kwargs": {
                            "dtype": "float32"
                        }
                    }
                ],
                "test_tensor": {
                    "sha256": "1b6a2ac5662e1a689a74974894d4076130fa128660095660f94f203547b341cd",
                    "source": "test-input.npy"
                }
            }
        ],
        "license": "CC-BY-4.0",
        "maintainers": [
            {
                "github_user": "danifranco",
                "name": "Daniel Franco-Barranco"
            }
        ],
        "name": "3D Residual U-Net for oocyte segmentation",
        "outputs": [
            {
                "axes": [
                    {
                        "size": 1,
                        "type": "batch"
                    },
                    {
                        "channel_names": [
                            "channel0",
                            "channel1",
                            "channel2"
                        ],
                        "type": "channel"
                    },
                    {
                        "halo": 4,
                        "id": "z",
                        "scale": 1,
                        "size": {
                            "axis_id": "z",
                            "offset": 0,
                            "tensor_id": "input0"
                        },
                        "type": "space"
                    },
                    {
                        "halo": 16,
                        "id": "y",
                        "scale": 1,
                        "size": {
                            "axis_id": "y",
                            "offset": 0,
                            "tensor_id": "input0"
                        },
                        "type": "space"
                    },
                    {
                        "halo": 16,
                        "id": "x",
                        "scale": 1,
                        "size": {
                            "axis_id": "x",
                            "offset": 0,
                            "tensor_id": "input0"
                        },
                        "type": "space"
                    }
                ],
                "data": {
                    "type": "float32"
                },
                "id": "output0",
                "postprocessing": [
                    {
                        "id": "ensure_dtype",
                        "kwargs": {
                            "dtype": "float32"
                        }
                    }
                ],
                "test_tensor": {
                    "sha256": "3e0c8617ea2698302f5670ca39f7cebede26dfae002904b65e0159847bda86fa",
                    "source": "test-output.npy"
                }
            }
        ],
        "tags": [
            "oocyte",
