                "reproducibility_tolerance": [
                    {
                        "relative_tolerance": 0.01,
                        "absolute_tolerance": 10,
                        "mismatched_elements_per_million": 1000
                    }
                ],
                "test_kwargs": {
                    "pytorch_state_dict": {
                        "absolute_tolerance": 50,
                        "relative_tolerance": 0.01
                    }
                }
            }
        },
