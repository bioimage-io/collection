            "cell-segmentation",
            "cellpose",
            "cellpose-dino",
            "dinov3",
            "pytorch",
            "bioimageio"
        ],
        "timestamp": "2026-08-10T00:00:00+02:00",
        "config": {
            "bioimageio": {
                "reproducibility_tolerance": [
                    {
                        "output_ids": [
                            "labels"
                        ],
                        "weights_formats": [
                            "pytorch_state_dict"
                        ],
                        "relative_tolerance": 0,
                        "absolute_tolerance": 0.001,
                        "mismatched_elements_per_million": 3000
                    }
                ]
            }
        },
        "inputs": [
            {
                "id": "input",
                "description": "2D microscopy image with exactly 3 channels. Single-channel images should be replicated across all three.",
                "axes": [
                    {
                        "type": "batch"
                    },
                    {
                        "type": "channel",
                        "channel_names": [
                            "channel0",
                            "channel1",
                            "channel2"
                        ]
                    },
                    {
                        "id": "y",
                        "type": "space",
                        "size": {
                            "min": 64,
                            "step": 8
                        }
                    },
                    {
                        "id": "x",
                        "type": "space",
                        "size": {
                            "min": 64,
                            "step": 8
                        }
                    }
                ],
                "pad": {
                    "value": 0
                },
                "preprocessing": [
                    {
                        "id": "ensure_dtype",
                        "kwargs": {
                            "dtype": "float32"
                        }
                    },
                    {
                        "id": "scale_range",
                        "kwargs": {
                            "axes": [
                                "y",
                                "x"
                            ],
                            "min_percentile": 1.0,
                            "max_percentile": 99.0,
                            "eps": 1e-6
                        }
                    }
                ],
                "test_tensor": {
                    "source": "test_input.npy",
                    "sha256": "716df1cdfa5a9b26e89ae4d359ed3c2ed5ca23a8ba817b8f85b65e6ea08802d7"
                },
                "sample_tensor": {
                    "source": "sample_input.png",
                    "sha256": "28417a3f87ec960155fd441e26bfcf9b005b04d5ae728b55a7302cb9e5d16fa9"
                }
            }
        ],
        "outputs": [
            {
                "id": "labels",
                "description": "Instance labels produced from flow_y, flow_x and cell probability.",
                "axes": [
                    {
                        "type": "batch"
                    },
                    {
                        "type": "channel",
                        "channel_names": [
                            "labels"
                        ]
                    },
                    {
                        "id": "y",
                        "type": "space",
                        "halo": 16,
                        "size": {
                            "tensor_id": "input",
                            "axis_id": "y"
                        }
                    },
                    {
                        "id": "x",
                        "type": "space",
                        "halo": 16,
                        "size": {
                            "tensor_id": "input",
                            "axis_id": "x"
                        }
                    }
                ],
                "postprocessing": [
                    {
                        "id": "cellpose_flow_dynamics",
                        "kwargs": {
                            "cellprob_threshold": 0,
                            "flow_threshold": 0.4,
                            "do_3D": false,
                            "min_size": 15,
                            "output_dtype": "uint16"
                        }
                    }
                ],
                "test_tensor": {
                    "source": "test_output.npy",
                    "sha256": "9d027e1af0e1551774889aaceb1dcd538af594d28572d7209f29401aea942efc"
                },
                "sample_tensor": {
                    "source": "sample_output.png",
                    "sha256": "073e2d6a016279a989c63615e10cabc300db2413785da75c690423621c2ed8d5"
                }
            }
        ],
        "weights": {
            "pytorch_state_dict": {
                "source": "https://huggingface.co/mouseland/cellpose-sam/resolve/main/cpdino",
                "sha256": "fad0dda262554922da1c5ab0e0004b00c1b14b8a48bea6781b89222567577573",
                "dependencies": {
                    "source": "environment.yaml",
                    "sha256": "544cbf1e364bcbf74827c2f0917feaaeb91d4adbdcda73df7bfba4291488246c"
                },
                "architecture": {
                    "source": "cpdino_instance_labels_arch.py",
                    "sha256": "ac34c875af36de417c3d15ea6f90b03484671cfa5634e48dcbe32148347d41c1",
                    "callable": "CellposeDINOModel"
                },
                "pytorch_version": "2.7.1",
                "strict": false,
                "comment": "Upstream MouseLand cpdino checkpoint. The architecture returns float32 flow_y, flow_x and cell-probability maps; instance masks are generated by the standard BioImage.IO cellpose_flow_dynamics postprocessing operation."
            }
        }
    },
