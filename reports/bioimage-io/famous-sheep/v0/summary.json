{
    "rdf_content": {
        "format_version": "0.5.10",
        "type": "model",
        "name": "CellposeDINO ViT-L 2D Microscopy Instance Segmenter",
        "description": "CellposeDINO with a DINOv3 ViT-L backbone for instance segmentation of 2D microscopy images. Following Cellpose-SAM v2, the network takes three input channels. Single-channel images should be replicated across all three. The network predicts Cellpose flows and cell probability. BioImage.IO flow dynamics converts them into uint16 labels.",
        "version": "0.1.5",
        "authors": [
