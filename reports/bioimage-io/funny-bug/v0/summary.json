                                2
                            ],
                            [
                                2,
                                2,
                                2
                            ]
                        ],
                        "initial_features": 32,
                        "gain": 2,
                        "norm": "InstanceNorm"
                    }
                }
            },
            "torchscript": {
                "source": "weights_torchscript.pt",
                "sha256": "a2af6ca07f663316f4fcb0fa48b238ac912bb36776489915f9caabc3a9d2eac0",
                "parent": "pytorch_state_dict",
                "pytorch_version": "2.7.1"
            }
        },
        "id": "funny-bug",
        "id_emoji": "🐛"
    },
    "rdf_yaml_sha256": "a0b7328cd12f779bb3dfb9993244cc3bd114c79f56fb03d964e756f63699b839",
