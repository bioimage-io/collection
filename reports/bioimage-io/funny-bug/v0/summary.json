{
    "rdf_content": {
        "format_version": "0.5.12",
        "type": "model",
        "name": "SynapseNet Vesicles - Electron Tomography",
        "description": "3D U-Net from SynapseNet that segments synaptic vesicles in electron tomograms of synapses at a voxel size of 1.35 nm (isotropic).",
        "license": "CC-BY-4.0",
        "authors": [
            {
                "name": "Sarah Muth",
                "github_user": "SarahMuth"
            }
        ],
        "maintainers": [
            {
                "name": "Luca Freckmann",
                "github_user": "lufre1"
            }
        ],
        "cite": [
            {
                "text": "Muth et al. SynapseNet: Deep learning for automatic synapse reconstruction. Molecular Biology of the Cell, 2025.",
                "doi": "10.1091/mbc.E24-11-0519"
            }
        ],
        "tags": [
            "synapsenet",
            "electron-microscopy",
            "electron-tomography",
            "synapse",
            "segmentation",
            "unet",
            "pytorch",
            "vesicles",
            "3d"
        ],
        "git_repo": "https://github.com/computational-cell-analytics/synapse-net",
        "documentation": {
            "source": "README.md",
            "sha256": "aab74c9cb59908a28d92be79e10b0ccb80305b6745761aed6f7fbb583666cb70"
        },
