                    },
                    {
                        "type": "channel",
                        "channel_names": [
                            "raw"
                        ]
                    },
                    {
                        "type": "space",
                        "id": "z",
                        "size": {
                            "min": 16,
                            "step": 8
                        }
                    },
                    {
                        "type": "space",
                        "id": "y",
                        "size": {
                            "min": 64,
                            "step": 16
                        }
                    },
                    {
                        "type": "space",
                        "id": "x",
                        "size": {
                            "min": 64,
                            "step": 16
                        }
                    }
                ],
                "test_tensor": {
                    "source": "test_input.npy",
                    "sha256": "aba3a2a0b9565e93d46d2761065c23e77869f2ba6ce09db0a5b4455e6ccebddd"
                },
                "preprocessing": [
                    {
                        "id": "ensure_dtype",
                        "kwargs": {
