                "pytorch_version": "2.7.1",
                "architecture": {
                    "source": "model.py",
                    "callable": "UNet",
                    "sha256": "1fb1a1c74a22cf6d27f19a8fea242280ef154481fe8e9c5caf392a73585f0831",
                    "kwargs": {
                        "in_channels": 1,
                        "out_channels": 2,
                        "scale_factors": [
                            [
                                1,
                                2,
                                2
                            ],
                            [
                                2,
                                2,
                                2
                            ],
                            [
                                2,
                                2,
                                2
                            ],
                            [
                                2,
                                2,
                                2
                            ]
                        ],
                        "initial_features": 32,
                        "gain": 2,
                        "norm": "InstanceNorm"
                    }
                }
            },
            "torchscript": {
                "source": "weights_torchscript.pt",
                "sha256": "f68dbaa2867b27b7743ea3a7d1c740700bc6d3b1baf33d35649547c3858fd7fe",
                "parent": "pytorch_state_dict",
                "pytorch_version": "2.7.1"
            }
        },
        "id": "quiet-lobster",
        "id_emoji": "🦞"
    },
    "rdf_yaml_sha256": "d8569d87e1569acc2493c0db4932dd25cecbed69dd836e46d0a82172b8231ff9",
    "status": "untested"
