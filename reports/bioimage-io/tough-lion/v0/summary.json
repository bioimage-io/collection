                        "type": "batch",
                        "size": 1
                    },
                    {
                        "type": "channel",
                        "channel_names": [
                            "raw_fluorescence"
                        ]
                    },
                    {
                        "type": "space",
                        "id": "y",
                        "size": 256
                    },
                    {
                        "type": "space",
                        "id": "x",
                        "size": 256
                    }
                ],
                "test_tensor": {
                    "source": "test_input.npy",
                    "sha256": "e307685a4df176ac68e7f602d99b363a413100be10fe99446ff379ab482dc71c"
                },
                "preprocessing": [
                    {
                        "id": "scale_range",
                        "kwargs": {
                            "axes": [
                                "y",
                                "x"
                            ],
                            "min_percentile": 0,
                            "max_percentile": 100
                        }
