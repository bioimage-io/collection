{
    "rdf_content": {
        "format_version": "0.5.4",
        "type": "model",
        "name": "DnCNN Blind Gaussian Denoiser for Fluorescence Microscopy",
        "description": "A 20-layer fully-convolutional residual network (DnCNN) for blind Gaussian noise removal in 2D grayscale fluorescence microscopy images. The network predicts the noise component and subtracts it from the input, producing a denoised image without requiring knowledge of the noise level.",
        "license": "MIT",
        "authors": [
            {
                "name": "Kai Zhang",
                "github_user": "cszn",
                "affiliation": "ETH Zurich"
            }
        ],
        "cite": [
            {
                "text": "K. Zhang, W. Zuo, Y. Chen, D. Meng, L. Zhang. Beyond a Gaussian Denoiser: Residual Learning of Deep CNN for Image Denoising. IEEE Transactions on Image Processing, 2017.",
                "doi": "10.1109/TIP.2017.2662206"
            },
            {
                "text": "KAIR: Image restoration toolbox. https://github.com/cszn/KAIR",
                "url": "https://github.com/cszn/KAIR"
            }
        ],
        "git_repo": "https://github.com/cszn/KAIR",
        "tags": [
            "denoising",
            "fluorescence",
            "2D",
            "pytorch",
            "torchscript",
            "grayscale",
            "restoration",
            "dncnn",
            "widefield",
            "confocal"
        ],
        "documentation": "README.md",
        "covers": [
            "cover.png"
        ],
        "timestamp": "2026-04-16T00:00:00+00:00",
        "inputs": [
