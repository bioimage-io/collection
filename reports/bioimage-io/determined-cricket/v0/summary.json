    "rdf_content": {
        "format_version": "0.5.10",
        "type": "model",
        "name": "NAFNet-GAN Planaria Spinning-Disk Denoiser",
        "description": "NAFNet-GAN is a supervised denoising model for single 2D slices from CARE Schmidtea mediterranea fluorescence microscopy stacks acquired with spinning-disk microscopy. It was developed for Dataset 1 of the AI4Life Microscopy Supervised Denoising Challenge 2025 and presented at ISBI 2026 in the paper “NAFNet-GAN: An Adversarial Framework for Supervised Fluorescence Microscopy Denoising.” The model uses a NAFNet-based adversarial framework to reduce low-light microscopy noise while preserving biological structures and restoring the original input intensity range.",
        "authors": [
            {
                "name": "Guillermo Rey-Paniagua",
                "affiliation": "Universidad Carlos III de Madrid, Getafe, Madrid, Spain",
                "orcid": "0009-0001-1903-2892"
