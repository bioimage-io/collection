{
    "rdf_content": {
        "format_version": "0.5.12",
        "type": "model",
        "name": "SynapseNet Vesicles - 2D TEM (Mouse)",
        "description": "2D U-Net from SynapseNet that segments synaptic vesicles in 2D transmission electron micrographs of mouse synapses at a voxel size of 1.35 nm.",
        "license": "CC-BY-4.0",
        "authors": [
            {
                "name": "Sarah Muth",
                "github_user": "SarahMuth"
            }
        ],
        "maintainers": [
            {
                "name": "Luca Freckmann",
                "github_user": "lufre1"
            }
        ],
        "cite": [
            {
                "text": "Muth et al. SynapseNet: Deep learning for automatic synapse reconstruction. Molecular Biology of the Cell, 2025.",
                "doi": "10.1091/mbc.E24-11-0519"
            }
        ],
        "tags": [
            "synapsenet",
            "electron-microscopy",
            "electron-microscopy-2d",
            "synapse",
            "segmentation",
            "unet",
            "pytorch",
            "vesicles",
            "2d",
            "transmission-electron-microscopy",
            "domain-adaptation"
        ],
        "git_repo": "https://github.com/computational-cell-analytics/synapse-net",
        "documentation": {
            "source": "README.md",
            "sha256": "e69b5b7fd7b5a3a45fdf50359502834120e60dc9523482049ed03dbb41a73e65"
        },
        "covers": [
            {
                "source": "cover.png",
                "sha256": "43a7a8e982fce70a3d89331cfeecb68ef77dedd7626d508d47c045b12b13b998"
            }
        ],
        "inputs": [
            {
                "id": "raw",
                "description": "Electron microscopy data",
                "axes": [
                    {
                        "type": "batch"
                    },
                    {
                        "type": "channel",
                        "channel_names": [
                            "raw"
                        ]
                    },
                    {
                        "type": "space",
                        "id": "y",
                        "size": {
                            "min": 64,
                            "step": 16
                        }
                    },
                    {
                        "type": "space",
                        "id": "x",
                        "size": {
                            "min": 64,
                            "step": 16
                        }
                    }
                ],
                "test_tensor": {
                    "source": "test_input.npy",
                    "sha256": "0cd6f464ec8eaa2928b100e456bc0a53949f926e00a4c9e428c0a3db014a2d36"
                },
                "preprocessing": [
                    {
                        "id": "ensure_dtype",
                        "kwargs": {
                            "dtype": "float32"
                        }
                    },
                    {
                        "id": "zero_mean_unit_variance",
                        "kwargs": {
                            "axes": [
                                "y",
                                "x"
                            ],
                            "eps": 1e-7
                        }
                    }
                ]
            }
        ],
        "outputs": [
            {
                "id": "prediction",
                "description": "Vesicle foreground and boundary probabilities",
                "axes": [
                    {
                        "type": "batch"
                    },
                    {
                        "type": "channel",
                        "channel_names": [
                            "foreground",
                            "boundaries"
                        ]
                    },
                    {
                        "type": "space",
                        "id": "y",
                        "size": {
                            "tensor_id": "raw",
                            "axis_id": "y"
                        },
                        "halo": 16
                    },
                    {
                        "type": "space",
                        "id": "x",
                        "size": {
                            "tensor_id": "raw",
                            "axis_id": "x"
                        },
                        "halo": 16
                    }
                ],
                "test_tensor": {
                    "source": "test_output.npy",
                    "sha256": "5ff523c7ee34a042cbedce4ffd0e141c3540e7ff4cd95b11043fe24ea347a38a"
                },
                "data": {
                    "range": [
                        0.0,
                        1.0
                    ]
                }
            }
        ],
        "weights": {
            "pytorch_state_dict": {
                "source": "weights.pt",
                "sha256": "99f70f1ba300f7d0b6468f07457dfcae0250917775d01f1b09b317b6c2e55c96",
                "pytorch_version": "2.7.1",
                "architecture": {
                    "source": "model.py",
                    "callable": "UNet",
                    "sha256": "1fb1a1c74a22cf6d27f19a8fea242280ef154481fe8e9c5caf392a73585f0831",
                    "kwargs": {
                        "in_channels": 1,
                        "out_channels": 2,
                        "scale_factors": [
                            [
                                2,
                                2
                            ],
                            [
                                2,
                                2
                            ],
                            [
                                2,
                                2
                            ],
                            [
                                2,
                                2
                            ]
                        ],
                        "initial_features": 32,
                        "gain": 2,
                        "norm": "InstanceNorm"
                    }
                }
            },
            "torchscript": {
                "source": "weights_torchscript.pt",
                "sha256": "38e2e70b061d494958acb42b5e5c180cc171ac3487f2fce99fa617579b90163e",
                "parent": "pytorch_state_dict",
                "pytorch_version": "2.7.1"
            }
        },
        "id": "hardworking-parrot",
        "id_emoji": "🦜"
    },
    "rdf_yaml_sha256": "f60662b8a8b4e8df4472f8ef998e6720f48cd8e5c47df26046614c7037fd21ad",
    "status": "untested"
}