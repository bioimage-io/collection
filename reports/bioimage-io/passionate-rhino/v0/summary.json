{
    "rdf_content": {
        "name": "Cellpose-SAM (cpsam_v2) grayscale",
        "description": "Cellpose-SAM (cpsam_v2 weights), the generalist cell and nucleus segmentation model of Cellpose 4 (SAM's ViT-L image encoder), for single-channel (grayscale) 2D images. Re-implemented with BiaPy, so it does not need the cellpose package. It outputs Cellpose's raw maps, named with BiaPy's channel codes: 'F' (cell probability, after a sigmoid), 'Gv' and 'Gh' (vertical and horizontal flows, x5). Cellpose's flow-following post-processing turns them into instances (as BiaPy does when consuming it).\nrepresentation: F+Gv+Gh",
        "covers": [
            {
                "source": "cover.png",
                "sha256": "5135c902e25975cde45f4954a6386d6677624534f09b4b003519182435f34251"
            }
        ],
